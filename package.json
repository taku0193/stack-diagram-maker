{
  "name": "stack-diagram-maker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite --port 5174 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4174",
    "test": "vitest run",
    "diagram:build": "python3 .agents/skills/stack-diagram/scripts/build.py diagrams/vue-fastapi-postgres.draft.html diagrams/icons public/diagrams/vue-fastapi-postgres.html --fonts .agents/skills/stack-diagram/assets/fonts",
    "diagram:build:steer": "python3 .agents/skills/stack-diagram/scripts/build.py diagrams/steer-clear-of-the-wall/draft.html diagrams/steer-clear-of-the-wall/icons public/diagrams/steer-clear-of-the-wall.html --fonts .agents/skills/stack-diagram/assets/fonts"
  },
  "devDependencies": {
    "jsdom": "^27.4.0",
    "typescript": "~5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.1.0"
  }
}
