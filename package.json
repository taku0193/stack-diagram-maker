{
  "name": "stack-diagram-maker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5174 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4174",
    "test": "vitest run",
    "diagram:build": "python3 .agents/skills/stack-diagram/scripts/build.py diagrams/vue-fastapi-postgres.draft.html diagrams/icons public/diagrams/vue-fastapi-postgres.html --fonts .agents/skills/stack-diagram/assets/fonts"
  },
  "devDependencies": {
    "jsdom": "^31.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.1.0"
  }
}
